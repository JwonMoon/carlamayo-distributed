[Unit]
Description=Carlamayo Alpamayo inference server (gRPC)
After=network-online.target
Wants=network-online.target

[Service]
# Replace <INFERENCE_HOST_IP> with B's private IP (deploy/hosts.env) and the paths with your checkout.
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/carlamayo
Environment=HF_HOME=/home/ubuntu/.cache/huggingface
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/carlamayo/a_venv/bin/python alpamayo_server.py --version 1.5 --host <INFERENCE_HOST_IP> --port 50051
Restart=on-failure
RestartSec=10
# Model load + warm-up can take several minutes.
TimeoutStartSec=900
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
