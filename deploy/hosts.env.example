# Two-host layout: copy to deploy/hosts.env and fill in YOUR instances.
# Sourced by deploy/scripts/*.sh and tools/fetch_server_profile.sh. Never commit hosts.env.
#
# A = simulator host (CARLA + carlamayo.py, x86), B = inference host (alpamayo_server.py, big-VRAM GPU).
# Use PRIVATE IPs (same VPC). The gRPC port must be open on B's security group for A.

SIM_HOST_IP=172.31.38.219
INFERENCE_HOST_IP=172.31.20.213
INFERENCE_PORT=50051

# SSH user on the inference host (ubuntu for Ubuntu AMIs, ec2-user for Amazon Linux)
INFERENCE_SSH_USER=ubuntu
# Repository checkout path on the inference host
REMOTE_REPO=~/carlamayo
